# Banco (usado pelo docker-compose e pelo Prisma)
POSTGRES_USER=cursos
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=cursos_db

# Conexão do Prisma
# Em docker-compose use host "db"; rodando localmente use "localhost"
DATABASE_URL=postgresql://cursos:troque_esta_senha@localhost:5432/cursos_db

# API
PORT=3333
JWT_SECRET=gere_um_segredo_bem_grande_aqui
CORS_ORIGIN=http://localhost:5173

# LLM: escolha o provedor (openrouter | ollama)
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=coloque_sua_chave_aqui
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (para usar depois: troque LLM_PROVIDER para "ollama")
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
